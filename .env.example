# Database - MySQL XAMPP
# XAMPP default biasanya user root tanpa password di port 3306.
# Jika port/user/password XAMPP Anda berbeda, sesuaikan bagian ini.
DATABASE_URL="mysql://root@localhost:3306/spensakas"

# Auth
# 10 terasa jauh lebih ringan untuk laptop/dev server. Naikkan ke 12+ jika CPU server kuat.
PASSWORD_HASH_ROUNDS=10

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="spensakas"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"
